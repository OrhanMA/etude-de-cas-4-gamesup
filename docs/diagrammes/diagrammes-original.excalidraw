      "isDeleted": false,
      "boundElements": [],
      "updated": 1793272045773,
      "created": 1793272045737,
      "link": null,
      "locked": false,
      "text": "Échanges externes (flèches à la frontière) :\nAngular → contrôleurs : requêtes HTTP\nRepositories → MySQL : JPA / Hibernate, JDBC\nServices → FastAPI : client HTTP à créer\nDTO et modèles : objets de données, pas services",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Échanges externes (flèches à la frontière) :\nAngular → contrôleurs : requêtes HTTP\nRepositories → MySQL : JPA / Hibernate, JDBC\nServices → FastAPI : client HTTP à créer\nDTO et modèles : objets de données, pas services",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
